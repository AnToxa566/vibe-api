PORT=8080
CLIENT_URL=http://localhost:3000

# База данных: либо DATABASE_URL (Supabase), либо отдельные DB_* (локальный Postgres)
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_NAME=vibe
DB_SSL=false
DB_SYNCHRONIZE=false
DB_POOL_SIZE=5

JWT_SECRET=secret

# Cloudflare R2
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Публичный адрес бакета (кастомный домен), без завершающего слэша
STORAGE_PUBLIC_URL=https://cdn.example.com
